{
  "name": "@borges360/pi-subagent-router",
  "version": "0.1.0",
  "description": "pi-subagent-router \u2014 independent, evidence-driven Pi extension",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Borges360/pi-subagent-router.git"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": "./dist/extension.js"
  },
  "bin": {
    "pi-subagent-router": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "ARCHITECTURE.md",
    "CONFIGURATION.md",
    "SECURITY.md",
    "MIGRATION.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "src",
    "benchmarks",
    "ACCEPTANCE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src tests benchmarks *.md",
    "schemas": "npm run build && node scripts/generate-schema.mjs"
  },
  "dependencies": {
    "typebox": "1.3.27",
    "yaml": "2.9.0",
    "fast-xml-parser": "5.11.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/chord": "1.2.0",
    "prettier": "3.9.10"
  }
}
